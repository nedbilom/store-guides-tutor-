<h1>Главная страница</h1>

<% if @products.present? %>
    <h2>Консоли</h2>

    <ul>
        <% @products.each do |product| %>
            <li>
               <%= link_to product.name, product %>
            </li>
        <% end %>
    </ul>
<% end %>

<% if @platform_holders.present? %>
    <h2>Платформодержатели</h2>

    <ul>
        <% @platform_holders.each do |platform| %>
            <li>
                <%= link_to platform.name, platform %>
            </li>
        <% end %>
    </ul>
<% end %>
